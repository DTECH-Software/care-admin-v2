<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="payment-advice"
              pageWidth="595" pageHeight="842"
              leftMargin="20" rightMargin="20" topMargin="10" bottomMargin="10"
              columnWidth="555"
              uuid="4c2d1d7e-2d17-4b4c-8f4f-6f4dd0a7b2c6">

    <property name="net.sf.jasperreports.print.keep.full.text" value="true"/>

    <style name="Base" fontName="SansSerif" fontSize="9" forecolor="#222222"/>
    <style name="TitleRed" style="Base" fontSize="17" isBold="true" isUnderline="false" forecolor="#D32F2F"/>
    <style name="HeaderName" style="Base" fontSize="12" isBold="true"/>
    <style name="Label" style="Base" isBold="true" forecolor="#111111"/>
    <style name="Footer" style="Base" fontSize="8" forecolor="#666666"/>
    <style name="TableHeader" style="Base" mode="Opaque" backcolor="#111111" forecolor="#FFFFFF" isBold="true">
        <box>
            <pen lineWidth="0.6" lineColor="#111111"/>
        </box>
        <paragraph leftIndent="4" rightIndent="4"/>
    </style>
    <style name="TableDetail" style="Base">
        <box>
            <pen lineWidth="0.3" lineColor="#C8CCD4"/>
        </box>
        <paragraph leftIndent="4" rightIndent="4"/>
    </style>

    <parameter name="logo" class="java.io.InputStream"/>
    <parameter name="adviceNo" class="java.lang.String"/>
    <parameter name="chequeNo" class="java.lang.String"/>
    <parameter name="voucherNo" class="java.lang.String"/>
    <parameter name="adviceDate" class="java.lang.String"/>
    <parameter name="company" class="java.lang.String"/>
    <parameter name="paymentCompany" class="java.lang.String"/>
    <parameter name="description" class="java.lang.String"/>
    <parameter name="department" class="java.lang.String"/>
    <parameter name="totalApprovedAmount" class="java.lang.String"/>
    <parameter name="totalRequestedAmount" class="java.lang.String"/>
    <parameter name="preparedBy" class="java.lang.String"/>

    <field name="attachmentNo" class="java.lang.String"/>
    <field name="companyCode" class="java.lang.String"/>
    <field name="companyDescription" class="java.lang.String"/>
    <field name="approvedAmount" class="java.math.BigDecimal"/>

    <variable name="rowNumber" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{attachmentNo}]]></variableExpression>
    </variable>

    <title>
        <band height="30">
            <textField>
                <reportElement x="0" y="0" width="555" height="30" style="TitleRed"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($P{totalApprovedAmount} != null && !$P{totalApprovedAmount}.trim().isEmpty() && new java.math.BigDecimal($P{totalApprovedAmount}.replace(",", "")).compareTo(java.math.BigDecimal.ZERO) == 0) ? "RETURN NOTE" : "PAYMENT ADVICE"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageHeader>
        <band height="140">
            <image>
                <reportElement x="0" y="-25" width="150" height="150"/>
                <imageExpression><![CDATA[$P{logo}]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="230" y="10" width="405" height="16" style="HeaderName"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Samson Group Corporate Services (Pvt) Ltd]]></text>
            </staticText>
            <staticText>
                <reportElement x="230" y="28" width="405" height="12" style="Base"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[110,Kumaran Rathnam Road,Colombo - 02]]></text>
            </staticText>
            <staticText>
                <reportElement x="230" y="42" width="405" height="12" style="Base"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Tel: 011-2131800,2320978,2320979 Fax: 011-2131777]]></text>
            </staticText>

            <frame>
                <reportElement x="0" y="70" width="555" height="70"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </box>

                <line>
                    <reportElement x="325" y="32" width="230" height="1"/>
                    <graphicElement>
                        <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                    </graphicElement>
                </line>
                <line>
                    <reportElement x="0" y="50" width="555" height="1"/>
                    <graphicElement>
                        <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                    </graphicElement>
                </line>
                <line>
                    <reportElement x="325" y="0" width="1" height="70"/>
                    <graphicElement>
                        <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                    </graphicElement>
                </line>
                <line>
                    <reportElement x="470" y="32" width="1" height="18"/>
                    <graphicElement>
                        <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                    </graphicElement>
                </line>
                <line>
                    <reportElement x="495" y="50" width="1" height="20"/>
                    <graphicElement>
                        <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                    </graphicElement>
                </line>

                <textField textAdjust="StretchHeight">
                    <reportElement x="6" y="4" width="318" height="44" style="Base"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"/>
                    <textFieldExpression><![CDATA["Original Company: " + $P{company} + "\nPayment Company: " + $P{paymentCompany}]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement x="330" y="4" width="225" height="14" style="Base"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"/>
                    <textFieldExpression><![CDATA["Payment Voucher: " + $P{voucherNo}]]></textFieldExpression>
                </textField>

                <textField textAdjust="ScaleFont">
                    <reportElement x="330" y="38" width="140" height="14" style="Base"/>
                    <textFieldExpression><![CDATA["Cheque No: " + $P{chequeNo}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="475" y="38" width="80" height="14" style="Base"/>
                    <textFieldExpression><![CDATA["Date: " + $P{adviceDate}]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement x="6" y="54" width="318" height="14" style="Base"/>
                    <textFieldExpression><![CDATA["Details/Description: " + $P{description}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="330" y="54" width="165" height="14" style="Label"/>
                    <text><![CDATA[Original Company]]></text>
                </staticText>
                <staticText>
                    <reportElement x="500" y="54" width="55" height="14" style="Label"/>
                    <text><![CDATA[Amount (Rs)]]></text>
                </staticText>
            </frame>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="0"/>
    </columnHeader>

    <detail>
        <band height="36">
            <line>
                <reportElement x="0" y="0" width="1" height="36"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="325" y="0" width="1" height="36"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="495" y="0" width="1" height="36"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="554" y="0" width="1" height="36"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="0" y="35" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>

            <textField>
                <reportElement x="6" y="0" width="318" height="36" style="Base"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{attachmentNo}]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight">
                <reportElement x="331" y="0" width="163" height="36" style="Base"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{companyDescription} == null || $F{companyDescription}.trim().isEmpty() ? $F{companyCode} : $F{companyDescription}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00">
                <reportElement x="500" y="0" width="55" height="36" style="Base"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{approvedAmount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <staticText>
                <reportElement x="0" y="4" width="555" height="12" style="Footer"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[@ Powered by DTech (PVT) LTD 2026. | +94 (0) 11 204 5240.]]></text>
            </staticText>
        </band>
    </pageFooter>

    <summary>
        <band height="60">
            <line>
                <reportElement x="0" y="0" width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="160" y="0" width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="325" y="0" width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="495" y="0" width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="554" y="0" width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="0" y="17" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>

            <staticText>
                <reportElement x="6" y="2" width="150" height="14" style="Label"/>
                <text><![CDATA[Department]]></text>
            </staticText>
            <textField>
                <reportElement x="166" y="2" width="150" height="14" style="Base"/>
                <textFieldExpression><![CDATA[$P{department}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="330" y="2" width="165" height="14" style="Label"/>
                <text><![CDATA[TOTAL AMOUNT]]></text>
            </staticText>
            <textField>
                <reportElement x="500" y="2" width="55" height="14" style="Base"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{totalApprovedAmount}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="24" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="0" y="42" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="0" y="24" width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="160" y="24" width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="325" y="24" width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="470" y="24" width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="554" y="24" width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#C8CCD4"/>
                </graphicElement>
            </line>

            <textField>
                <reportElement x="6" y="26" width="150" height="12" style="Base"/>
                <textFieldExpression><![CDATA["Prepared By: " + ($P{preparedBy} == null ? "" : $P{preparedBy})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="166" y="26" width="150" height="12" style="Base"/>
                <text><![CDATA[Checked By: ]]></text>
            </staticText>
            <staticText>
                <reportElement x="330" y="26" width="140" height="12" style="Base"/>
                <text><![CDATA[Authorized By: ]]></text>
            </staticText>
            <staticText>
                <reportElement x="475" y="26" width="80" height="12" style="Base"/>
                <text><![CDATA[Received By: ]]></text>
