<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="payment-attachment"
              pageWidth="595" pageHeight="842"
              leftMargin="20" rightMargin="20" topMargin="10" bottomMargin="10"
              columnWidth="555"
              uuid="e7a4b3a5-6c16-4fd6-9f4b-0d78e4c2a1b7">

    <property name="net.sf.jasperreports.print.keep.full.text" value="true"/>

    <style name="Base" fontName="SansSerif" fontSize="9" forecolor="#222222"/>
    <style name="Title" style="Base" fontSize="14" isBold="true"/>
    <style name="Label" style="Base" isBold="true" forecolor="#111111"/>
    <style name="TableHeader" style="Base" fontSize="8" mode="Opaque" backcolor="#1F2937" forecolor="#FFFFFF" isBold="true">
        <box>
            <pen lineWidth="0.6" lineColor="#111827"/>
        </box>
        <paragraph leftIndent="3" rightIndent="3"/>
    </style>
    <style name="TableDetail" style="Base" fontSize="8">
        <box>
            <pen lineWidth="0.3" lineColor="#D1D5DB"/>
        </box>
        <paragraph leftIndent="3" rightIndent="3"/>
    </style>
    <style name="SummaryText" style="Base" isBold="true"/>
    <style name="SystemGeneratedText" style="Base" fontSize="11" isBold="true" forecolor="#000000"/>
    <style name="Footer" style="Base" fontSize="8" forecolor="#666666"/>

    <parameter name="logo" class="java.io.InputStream"/>
    <parameter name="attachmentNo" class="java.lang.String"/>
    <parameter name="dateFrom" class="java.lang.String"/>
    <parameter name="dateTo" class="java.lang.String"/>
    <parameter name="companyCode" class="java.lang.String"/>
    <parameter name="paymentCompanyCode" class="java.lang.String"/>
    <parameter name="staffCategoryCode" class="java.lang.String"/>
    <parameter name="treatmentCategory" class="java.lang.String"/>
    <parameter name="notes" class="java.lang.String"/>
    <parameter name="createdBy" class="java.lang.String"/>
    <parameter name="totalClaims" class="java.lang.Integer"/>
    <parameter name="totalRequestedAmount" class="java.lang.String"/>
    <parameter name="totalApprovedAmount" class="java.lang.String"/>

    <field name="requestId" class="java.lang.String"/>
    <field name="companyCode" class="java.lang.String"/>
    <field name="companyDescription" class="java.lang.String"/>
    <field name="paymentCompanyCode" class="java.lang.String"/>
    <field name="paymentCompanyDescription" class="java.lang.String"/>
    <field name="epf" class="java.lang.String"/>
    <field name="requestAmount" class="java.math.BigDecimal"/>
    <field name="approvedAmount" class="java.math.BigDecimal"/>
    <field name="remark" class="java.lang.String"/>
    <field name="claimStatus" class="java.lang.String"/>

    <title>
        <band height="50">
            <image>
                <reportElement x="0" y="0" width="50" height="50"/>
                <imageExpression><![CDATA[$P{logo}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="60" y="0" width="495" height="50" style="Title"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Payment Attachment Report]]></text>
            </staticText>
        </band>
    </title>

    <pageHeader>
        <band height="122">
            <staticText>
                <reportElement x="0" y="0" width="90" height="14" style="Label"/>
                <text><![CDATA[Attachment No:]]></text>
            </staticText>
            <textField>
                <reportElement x="92" y="0" width="250" height="14" style="Base"/>
                <textFieldExpression><![CDATA[$P{attachmentNo}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="330" y="0" width="75" height="14" style="Label"/>
                <text><![CDATA[Date Range:]]></text>
            </staticText>
            <textField>
                <reportElement x="407" y="0" width="148" height="14" style="Base"/>
                <textFieldExpression><![CDATA[
                    ($P{dateFrom} == null ? "" : $P{dateFrom})
                    + " / "
                    + ($P{dateTo} == null ? "" : $P{dateTo})
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="18" width="120" height="14" style="Label"/>
                <text><![CDATA[Original Company:]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="122" y="18" width="433" height="16" style="Base"/>
                <textFieldExpression><![CDATA[$P{companyCode}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="36" width="120" height="14" style="Label"/>
                <text><![CDATA[Payment Company:]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="122" y="36" width="433" height="16" style="Base"/>
                <textFieldExpression><![CDATA[$P{paymentCompanyCode}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="54" width="120" height="14" style="Label"/>
                <text><![CDATA[Staff Category:]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="122" y="54" width="433" height="16" style="Base"/>
                <textFieldExpression><![CDATA[$P{staffCategoryCode}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="72" width="120" height="14" style="Label"/>
                <text><![CDATA[Treatment Category:]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="122" y="72" width="433" height="16" style="Base"/>
                <textFieldExpression><![CDATA[$P{treatmentCategory}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="92" width="120" height="14" style="Label"/>
                <text><![CDATA[Details/Description:]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="122" y="92" width="433" height="24" style="Base"/>
                <textFieldExpression><![CDATA[$P{notes} == null ? "" : $P{notes}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="34">
            <staticText>
                <reportElement x="0" y="0" width="132" height="34" style="TableHeader"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Request ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="132" y="0" width="90" height="34" style="TableHeader"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Original
Company]]></text>
            </staticText>
            <staticText>
                <reportElement x="222" y="0" width="90" height="34" style="TableHeader"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Payment
Company]]></text>
            </staticText>
            <staticText>
                <reportElement x="312" y="0" width="38" height="34" style="TableHeader"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[EPF No]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="0" width="58" height="34" style="TableHeader"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Submitted
Amount]]></text>
            </staticText>
            <staticText>
                <reportElement x="408" y="0" width="58" height="34" style="TableHeader"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Received
Amount]]></text>
            </staticText>
            <staticText>
                <reportElement x="466" y="0" width="89" height="34" style="TableHeader"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Remark]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="40">
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="0" width="132" height="40" style="TableDetail"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{requestId}]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight">
                <reportElement x="132" y="0" width="90" height="40" style="TableDetail"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    ($F{companyCode} == null ? "" : $F{companyCode})
                    + (($F{companyDescription} != null && !$F{companyDescription}.trim().isEmpty())
                        ? "\n" + $F{companyDescription}
                        : "")
                ]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight">
                <reportElement x="222" y="0" width="90" height="40" style="TableDetail"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    ($F{paymentCompanyCode} == null ? "" : $F{paymentCompanyCode})
                    + (($F{paymentCompanyDescription} != null && !$F{paymentCompanyDescription}.trim().isEmpty())
                        ? "\n" + $F{paymentCompanyDescription}
                        : "")
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="312" y="0" width="38" height="40" style="TableDetail"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{epf}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00">
                <reportElement x="350" y="0" width="58" height="40" style="TableDetail"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{requestAmount}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00">
                <reportElement x="408" y="0" width="58" height="40" style="TableDetail"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{approvedAmount}]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight">
                <reportElement x="466" y="0" width="89" height="40" style="TableDetail"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    ($F{remark} != null && !$F{remark}.trim().isEmpty())
                    ? $F{remark}
                    : ($F{claimStatus} == null ? "" : $F{claimStatus})
                ]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="12">
            <staticText>
                <reportElement x="0" y="0" width="555" height="12" style="Footer"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[@ Powered by DTech (PVT) LTD 2026. | +94 (0) 11 204 5240.]]></text>
            </staticText>
        </band>
    </pageFooter>

    <summary>
        <band height="108">
            <textField>
                <reportElement x="0" y="0" width="555" height="18" style="SummaryText"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    "Total Claims: " + $P{totalClaims}
                    + "   |   Total Submitted Amount: " + $P{totalRequestedAmount}
                    + "   |   Total Received Amount: " + $P{totalApprovedAmount}
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="32" width="555" height="14" style="Base"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    "Generated By: " + ($P{createdBy} == null ? "" : $P{createdBy}) + "    User Level: __________________"
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="54" width="555" height="14" style="Base"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    "Created By: " + ($P{createdBy} == null ? "" : $P{createdBy}) + "    Checked By: __________________"
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="88" width="555" height="16" style="SystemGeneratedText"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[This is a system-generated document and does not require a signature.]]></text>
            </staticText>

        </band>
    </summary>

</jasperReport>
